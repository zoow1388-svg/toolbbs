{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "development-handoff.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "base_revision", "changed_files", "summary", "created_at"],
  "properties": {
    "task_id": {"type": "string", "pattern": "^[A-Z]+-[0-9]{3,}$"},
    "base_revision": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
    "changed_files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "summary": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
