{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "verification-receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["workflow_id", "task_id", "dispatch_id", "thread_id", "result_message_id", "raw_result_path", "raw_result_sha256", "normalized_result_path", "normalized_result_sha256", "validator", "validation_output", "verified_at"],
  "properties": {
    "workflow_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "dispatch_id": {"type": "string", "minLength": 1},
    "thread_id": {"type": "string", "minLength": 1},
    "result_message_id": {"type": "string", "minLength": 1},
    "raw_result_path": {"type": "string", "minLength": 1},
    "raw_result_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "normalized_result_path": {"type": "string", "minLength": 1},
    "normalized_result_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "validator": {"const": "validate-result.ps1"},
    "validation_output": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "verified_at": {"type": "string", "format": "date-time"}
  }
}
