{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"git-action.schema.json","type":"object","additionalProperties":false,
  "required":["git_action_id","logical_key","task_id","operation","operation_id","controller_thread_id","controller_host_id","controller_epoch","attempt","status","request_path","request_sha256","receipt_path","receipt_sha256","resolution_evidence_path","resolution_evidence_sha256","error","created_at","completed_at","failed_at","cancelled_at"],
  "properties":{
    "git_action_id":{"type":"string","minLength":1},"logical_key":{"type":"string","minLength":1},"task_id":{"type":"string","minLength":1},"operation":{"enum":["create_worktree","stage","commit","merge"]},"operation_id":{"type":"string","minLength":1},
    "controller_thread_id":{"type":"string","minLength":1},"controller_host_id":{"type":"string","minLength":1},"controller_epoch":{"type":"integer","minimum":1},"attempt":{"type":"integer","minimum":1},"status":{"enum":["prepared","completed","failed","cancelled"]},
    "request_path":{"type":"string"},"request_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"receipt_path":{"type":["string","null"]},"receipt_sha256":{"type":["string","null"],"pattern":"^[a-f0-9]{64}$"},
    "resolution_evidence_path":{"type":["string","null"]},"resolution_evidence_sha256":{"type":["string","null"],"pattern":"^[a-f0-9]{64}$"},"error":{"type":["string","null"]},"created_at":{"type":"string","format":"date-time"},"completed_at":{"type":["string","null"],"format":"date-time"},"failed_at":{"type":["string","null"],"format":"date-time"},"cancelled_at":{"type":["string","null"],"format":"date-time"}
  }
}
