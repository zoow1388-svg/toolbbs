{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "action-execution.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["execution_id", "action_id", "action_type", "task_ids", "operation_sha256", "attempt", "plan_path", "plan_sha256", "action_sha256", "controller_thread_id", "controller_host_id", "controller_epoch", "status", "lease_expires_at", "evidence_path", "evidence_sha256", "error", "resolution_reason", "retry_reason", "retry_evidence_path", "retry_evidence_sha256", "claimed_at", "completed_at", "failed_at", "resolved_at", "retry_authorized_at"],
  "properties": {
    "execution_id": {"type": "string", "minLength": 1},
    "action_id": {"type": "string", "minLength": 1},
    "action_type": {"type": "string", "minLength": 1},
    "task_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "operation_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "attempt": {"type": "integer", "minimum": 1},
    "plan_path": {"type": "string", "pattern": "^[A-Za-z]:\\\\"},
    "plan_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "action_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "controller_thread_id": {"type": "string", "minLength": 1},
    "controller_host_id": {"type": "string", "minLength": 1},
    "controller_epoch": {"type": "integer", "minimum": 1},
    "status": {"enum": ["claimed", "completed", "failed", "abandoned", "reconciled", "retry_authorized"]},
    "lease_expires_at": {"type": "string", "format": "date-time"},
    "evidence_path": {"type": ["string", "null"]},
    "evidence_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "error": {"type": ["string", "null"]},
    "resolution_reason": {"type": ["string", "null"]},
    "retry_reason": {"type": ["string", "null"]},
    "retry_evidence_path": {"type": ["string", "null"]},
    "retry_evidence_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "claimed_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": ["string", "null"], "format": "date-time"},
    "failed_at": {"type": ["string", "null"], "format": "date-time"},
    "resolved_at": {"type": ["string", "null"], "format": "date-time"},
    "retry_authorized_at": {"type": ["string", "null"], "format": "date-time"}
  }
}
