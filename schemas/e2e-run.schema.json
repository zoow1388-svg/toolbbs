{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "e2e-run.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["workflow_id", "repository_root", "controller_thread_id", "tasks", "development", "test", "review", "created_at"],
  "properties": {
    "workflow_id": {"type": "string", "minLength": 1},
    "repository_root": {"type": "string", "pattern": "^[A-Za-z]:\\\\"},
    "controller_thread_id": {"type": "string", "minLength": 1},
    "tasks": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["task_id", "thread_id", "role", "worktree_path", "base_revision", "end_revision", "callback_status", "verification_status"],
        "properties": {
          "task_id": {"type": "string", "pattern": "^[A-Z]+-[0-9]{3,}$"},
          "thread_id": {"type": "string", "minLength": 1},
          "role": {"enum": ["analyst", "developer", "tester", "reviewer"]},
          "worktree_path": {"type": "string", "pattern": "^[A-Za-z]:\\\\"},
          "base_revision": {"type": "string", "minLength": 1},
          "end_revision": {"type": "string", "minLength": 1},
          "callback_status": {"const": "acknowledged"},
          "verification_status": {"const": "trusted"}
        }
      }
    },
    "development": {"type": "object", "additionalProperties": false, "required": ["commit", "changed_files"], "properties": {"commit": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"}, "changed_files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}},
    "test": {"type": "object", "additionalProperties": false, "required": ["inspected_revision", "checks"], "properties": {"inspected_revision": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"}, "checks": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["name", "status", "exit_code"], "properties": {"name": {"type": "string", "minLength": 1}, "status": {"const": "passed"}, "exit_code": {"const": 0}}}}}},
    "review": {"type": "object", "additionalProperties": false, "required": ["inspected_revision", "outcome", "findings"], "properties": {"inspected_revision": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"}, "outcome": {"const": "passed"}, "findings": {"type": "array", "maxItems": 0}}},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
