{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "git-operation-receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["operation_id", "operation", "request_path", "request_sha256", "repository_root", "worktree_path", "branch_name", "base_revision", "end_revision", "changed_files", "test_evidence_sha256", "review_evidence_sha256", "push_performed", "force_performed", "status", "completed_at"],
  "properties": {
    "operation_id": {"type": "string", "minLength": 1},
    "operation": {"enum": ["create_worktree", "stage", "commit", "merge"]},
    "request_path": {"type": "string", "pattern": "^[A-Za-z]:\\\\"},
    "request_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "repository_root": {"type": "string", "pattern": "^[A-Za-z]:\\\\"},
    "worktree_path": {"type": "string", "pattern": "^[A-Za-z]:\\\\"},
    "branch_name": {"type": "string", "minLength": 1},
    "base_revision": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
    "end_revision": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
    "changed_files": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "test_evidence_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "review_evidence_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "push_performed": {"const": false},
    "force_performed": {"const": false},
    "status": {"const": "completed"},
    "completed_at": {"type": "string", "format": "date-time"}
  }
}
