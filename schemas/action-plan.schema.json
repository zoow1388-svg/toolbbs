{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "action-plan.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workflow_id", "project_path", "controller_thread_id", "controller_host_id", "controller_epoch", "based_on_event_sequence", "workflow_state_sha256", "tasks_state_sha256", "external_actions_sha256", "action_executions_sha256", "generated_at", "actions"],
  "properties": {
    "schema_version": {"const": 6},
    "workflow_id": {"type": "string", "minLength": 1},
    "project_path": {"type": "string", "pattern": "^[A-Za-z]:\\\\"},
    "controller_thread_id": {"type": ["string", "null"]},
    "controller_host_id": {"type": ["string", "null"]},
    "controller_epoch": {"type": "integer", "minimum": 0},
    "based_on_event_sequence": {"type": "integer", "minimum": 0},
    "workflow_state_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "tasks_state_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "external_actions_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "action_executions_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action_id", "type", "task_ids", "based_on_event_sequence", "operation", "parameters", "operation_sha256", "evidence_required", "state_changing", "authorization_required", "reason"],
        "properties": {
          "action_id": {"type": "string", "minLength": 1},
          "type": {"enum": ["request_authorization", "prepare_dispatch", "begin_external_action", "inspect_external_action", "inspect_action_execution", "resolve_action_execution", "request_retry_authorization", "record_external_action", "controlled_git", "send_message", "wait_tasks", "read_result", "normalize_result", "verify_result", "send_callback_ack", "wait_callback", "complete_task", "manual_review", "workflow_complete"]},
          "task_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "based_on_event_sequence": {"type": "integer", "minimum": 0},
          "operation": {"type": "string", "minLength": 1},
          "parameters": {"type": "object"},
          "operation_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "evidence_required": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "state_changing": {"type": "boolean"},
          "authorization_required": {"type": ["string", "null"]},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
