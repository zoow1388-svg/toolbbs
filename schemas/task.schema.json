{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "thread_id", "host_id", "role", "status", "depends_on", "project_path", "base_revision", "allowed_files", "objective", "authorization", "repair_count", "updated_at"],
  "properties": {
    "task_id": {"type": "string", "pattern": "^[A-Z]+-[0-9]{3,}$"},
    "thread_id": {"type": "string", "minLength": 1},
    "host_id": {"type": "string", "minLength": 1},
    "role": {"enum": ["analyst", "developer", "tester", "reviewer"]},
    "repair_of": {"type": ["string", "null"]},
    "status": {"enum": ["draft", "awaiting_approval", "approved", "dispatched", "running", "verifying", "completed", "blocked", "failed", "cancelled", "stale"]},
    "depends_on": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "project_path": {"type": "string", "pattern": "^[A-Za-z]:\\\\"},
    "base_revision": {"type": "string", "minLength": 1},
    "allowed_files": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "objective": {"type": "string", "minLength": 1},
    "authorization": {"enum": ["read-only", "plan-approved", "implementation-approved", "test-approved", "git-approved", "deployment-approved"]},
    "repair_count": {"type": "integer", "minimum": 0, "maximum": 1},
    "dispatch_count": {"type": "integer", "minimum": 0, "maximum": 1},
    "dispatch_id": {"type": ["string", "null"]},
    "delivery_status": {"enum": ["not-prepared", "prepared", "sent", "acknowledged", "result_received"]},
    "dispatch_path": {"type": ["string", "null"]},
    "sent_message_id": {"type": ["string", "null"]},
    "send_receipt_path": {"type": ["string", "null"]},
    "send_receipt_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "result_message_id": {"type": ["string", "null"]},
    "read_cursor": {"type": ["string", "null"]},
    "wait_revision": {"type": ["integer", "null"], "minimum": 0},
    "wait_snapshot_path": {"type": ["string", "null"]},
    "wait_snapshot_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "latest_turn_id": {"type": ["string", "null"]},
    "latest_turn_status": {"type": ["string", "null"]},
    "latest_item_id": {"type": ["string", "null"]},
    "latest_item_phase": {"type": ["string", "null"]},
    "result_truncated": {"type": "boolean"},
    "callback_event_id": {"type": ["string", "null"]},
    "callback_target_thread_id": {"type": ["string", "null"]},
    "callback_target_host_id": {"type": ["string", "null"]},
    "dispatch_controller_epoch": {"type": ["integer", "null"], "minimum": 1},
    "callback_status": {"enum": ["not-prepared", "prepared", "received", "acknowledged"]},
    "callback_receipt_path": {"type": ["string", "null"]},
    "callback_receipt_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "callback_received_at": {"type": ["string", "null"], "format": "date-time"},
    "callback_ack_receipt_path": {"type": ["string", "null"]},
    "callback_ack_receipt_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "callback_acknowledged_at": {"type": ["string", "null"], "format": "date-time"},
    "observation_path": {"type": ["string", "null"]},
    "observation_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "observed_status": {"enum": ["active", "idle", "completed", "needs_attention", "unavailable", "unknown", null]},
    "observed_at": {"type": ["string", "null"], "format": "date-time"},
    "dispatched_at": {"type": ["string", "null"], "format": "date-time"},
    "acknowledged_at": {"type": ["string", "null"], "format": "date-time"},
    "result_received_at": {"type": ["string", "null"], "format": "date-time"},
    "raw_result_path": {"type": ["string", "null"]},
    "raw_result_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "normalized_result_path": {"type": ["string", "null"]},
    "normalized_result_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "verification_receipt_path": {"type": ["string", "null"]},
    "verification_receipt_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "verification_status": {"enum": ["unverified", "trusted", "legacy-unverified"]},
    "verified_at": {"type": ["string", "null"], "format": "date-time"},
    "verified": {"type": "boolean"},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
