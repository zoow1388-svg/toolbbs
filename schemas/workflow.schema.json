{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workflow.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["workflow_id", "project_path", "status", "authorization", "created_at", "updated_at"],
  "properties": {
    "workflow_id": {"type": "string", "minLength": 1},
    "project_path": {"type": "string", "pattern": "^[A-Za-z]:\\\\"},
    "state_version": {"type": "integer", "minimum": 1},
    "current_stage": {"enum": ["analysis", "implementation", "test", "review", "delivery"]},
    "event_sequence": {"type": "integer", "minimum": 0},
    "status": {"enum": ["draft", "awaiting_approval", "approved", "dispatched", "running", "verifying", "completed", "blocked", "failed", "cancelled", "stale"]},
    "authorization": {"enum": ["read-only", "plan-approved", "implementation-approved", "test-approved", "git-approved", "deployment-approved"]},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
