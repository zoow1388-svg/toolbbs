{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workflow.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["workflow_id", "project_path", "controller_thread_id", "controller_host_id", "controller_epoch", "controller_history", "status", "authorization", "created_at", "updated_at"],
  "properties": {
    "workflow_id": {"type": "string", "minLength": 1},
    "project_path": {"type": "string", "pattern": "^[A-Za-z]:\\\\"},
    "controller_thread_id": {"type": ["string", "null"], "minLength": 1},
    "controller_host_id": {"type": ["string", "null"], "minLength": 1},
    "controller_epoch": {"type": "integer", "minimum": 0},
    "controller_history": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["epoch", "thread_id", "host_id", "replaced_at", "reason"], "properties": {"epoch": {"type": "integer", "minimum": 1}, "thread_id": {"type": "string", "minLength": 1}, "host_id": {"type": "string", "minLength": 1}, "replaced_at": {"type": "string", "format": "date-time"}, "reason": {"type": "string", "minLength": 1}}}},
    "state_version": {"type": "integer", "minimum": 1},
    "current_stage": {"enum": ["analysis", "implementation", "test", "review", "delivery"]},
    "event_sequence": {"type": "integer", "minimum": 0},
    "git_worktree_root": {"type": ["string", "null"], "pattern": "^[A-Za-z]:\\\\"},
    "git_target_branch": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "awaiting_approval", "approved", "dispatched", "running", "verifying", "completed", "blocked", "failed", "cancelled", "stale"]},
    "authorization": {"enum": ["read-only", "plan-approved", "implementation-approved", "test-approved", "git-approved", "deployment-approved"]},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
